# tpkg-builder image pins — the image-side single source of truth.
#
# SSOT discipline (ecosystem AGENTS.md §11 invariant 10): every value below
# names its upstream OWNER. Where the owner's value is machine-readable the
# bake asserts parity and fails loudly on drift (the vcpkg baseline is
# checked against the cloned dwarfs-t/vcpkg.json at bake time); the rest are
# documented flow points a bump edits in the same commit as the owner.

# The pinned Rust toolchain.
# Owner: tamatebako/tebako .github/workflows/release.yml (env RUST_VERSION;
# ci.yml and tebako-runtime-ruby's _build-platform.yml pin the same version
# via dtolnay/rust-toolchain@1.94.1).
RUST_VERSION=1.94.1

# The vcpkg baseline commit.
# Owner: tamatebako/dwarfs-t vcpkg.json (builtin-baseline) — machine-checked
# at bake time. Mirrors: tebako-rs ci.yml/release.yml env VCPKG_COMMIT,
# tebako-runtime-ruby _build-platform.yml, the feedstock imager legs.
VCPKG_COMMIT=f14401ca0f2754347c3864da7488a9b955b4e47a

# dwarfs-rs: the dwarfs-t-sys FFI crate + the pinned dwarfs-t submodule it
# carries. dwarfs-rs has no releases yet (it is a sibling path dependency
# across the ecosystem), so pin a main-branch commit. Baked at /opt/dwarfs-rs:
# the smoke probe's path dependency and the reference checkout a consumer
# matches to reuse the baked vcpkg tree (a moved dwarfs-t manifest rebuilds
# drifted ports in-leg — correct, just slower).
DWARFS_RS_REF=6f0fdcb0de3f8e8eebd18a45d9e633ac0096bb76

# The tebako product repo: the baked binaries (tebako-bootstrap, tfs,
# tebako-pkg, tebako, tebako-shim), tools/stage_link_unit (the factory's
# link-unit staging tool), and the sqfs-sys vcpkg manifest. Baked at
# /opt/tebako-rs. Owner of the tag namespace: tamatebako/tebako releases.
TEBAKO_REF=v0.1.1

# The runtime-factory build tooling (tools/build_runtime), baked at
# /opt/tebako-runtime-ruby. Owner: tamatebako/tebako-runtime-ruby releases
# (v0.16.2 is the first tag carrying tools/build_runtime — the archived v1
# images pinned a main commit because no tag did).
TEBAKO_RUNTIME_RUBY_REF=v0.16.2

# cmake for the glibc-floor image (Kitware binary tarball — focal's stock
# 3.16 predates dwarfs-t's cmake_minimum_required 3.28 and librnp's 3.18;
# tebako-rs ci/gnu-floor-build.sh). The musl image uses alpine 3.21's apk
# cmake (3.31.x — the boost-1.90-era floor is >= 3.25; proven by the
# tebako-rs release musl legs, ci/musl-build.sh).
CMAKE_VERSION=3.31.8

# patchelf (glibc-floor image only): the runtime factory's --patchelf pass
# and general RPATH surgery. Focal's apt patchelf (0.10) is too old.
PATCHELF_VERSION=0.18.0

# Toolchain ruby for the glibc-floor image (focal's apt ruby is 2.7 and
# feedstock tools need >= 3 — tools/lib/tpkg.rb uses endless defs). Built
# with ruby-install; the patchlevel floats within 3.3 on rebuilds (a
# tooling interpreter, never linked into artifacts). The musl image uses
# alpine 3.21's apk ruby (3.3.x).
RUBY_TOOLCHAIN_VERSION=3.3
RUBY_INSTALL_VERSION=0.10.2
